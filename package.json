{
  "name": "omniterm",
  "description": "OmniTerm: an offline multi-window SSH/RDP/local terminal and connection manager for Windows and macOS.",
  "author": "OmniTerm Contributors",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm assets:generate && vite",
    "dev:frontend": "pnpm assets:generate && vite",
    "build:frontend": "pnpm assets:generate && tsc && vite build",
    "tauri:dev": "pnpm tauri:dev:basic",
    "tauri:dev:basic": "pnpm assets:generate && tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:dev:full": "pnpm assets:generate && cross-env OMNITERM_DEV_PLUGIN=plugins/full-connection-manager tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:dev:limited": "pnpm assets:generate && cross-env OMNITERM_DEV_PLUGIN=plugins/native-batch-connections tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "pnpm assets:generate && tauri build",
    "build:tauri:nsis": "pnpm assets:generate && tauri build --bundles nsis",
    "lint": "pnpm assets:generate && pnpm lint:eslint && pnpm lint:loc && pnpm lint:dead-code",
    "lint:tauri": "pnpm assets:generate && cargo clippy --workspace --all-targets -- -D warnings",
    "test": "pnpm assets:generate && node scripts/check-no-password-persistence.mjs && pnpm test:quality && vitest run",
    "test:tauri": "pnpm assets:generate && cargo test --workspace",
    "preview": "vite preview",
    "create:app": "powershell -ExecutionPolicy Bypass -File scripts/Build-OmniTerm.ps1",
    "create:plugin": "node scripts/create-plugin.mjs",
    "build:plugin": "node scripts/build-plugin.mjs",
    "run:plugin": "node scripts/run-plugin.mjs",
    "install:plugin": "node scripts/install-plugin.mjs",
    "test:security": "node scripts/check-no-password-persistence.mjs",
    "lint:eslint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:loc": "node scripts/check-loc.mjs",
    "test:quality": "node --test \"scripts/__tests__/*.test.mjs\"",
    "coverage:js": "pnpm assets:generate && vitest run --coverage",
    "lint:dead-code": "node scripts/check-dead-code.mjs",
    "assets:generate": "node scripts/generate-app-assets.mjs",
    "typecheck": "pnpm assets:generate && tsc -b",
    "prepare": "husky || true",
    "check:push": "node scripts/pre-push-check.mjs",
    "identity:setup": "node scripts/identity-setup.mjs",
    "github": "node scripts/github.mjs",
    "bump:version": "node scripts/bump-version.mjs",
    "version:sync": "node scripts/sync-tauri-version.mjs write",
    "version:validate": "node scripts/sync-tauri-version.mjs validate"
  },
  "dependencies": {
    "@omniterm/contract": "workspace:*",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-os": "^2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "mermaid": "^11.16.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.2.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  }
}
