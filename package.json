{
  "name": "omniterm",
  "description": "OmniTerm: an offline multi-window SSH/RDP/local terminal and connection manager for Windows and macOS.",
  "author": "OmniTerm Contributors",
  "private": true,
  "version": "0.1.14",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm assets:generate && node scripts/free-dev-port.mjs && vite",
    "dev:frontend": "pnpm assets:generate && node scripts/free-dev-port.mjs && vite",
    "build:frontend": "pnpm assets:generate && tsc && tsc -p ui/ide --noEmit && vite build",
    "tauri:dev": "pnpm tauri:dev:basic",
    "tauri:dev:basic": "pnpm assets:generate && pnpm stage:plugins && tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:dev:full": "pnpm assets:generate && pnpm stage:plugins && cross-env OMNITERM_DEV_PLUGIN=plugins/full-connection-manager tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:dev:limited": "pnpm assets:generate && pnpm stage:plugins && cross-env OMNITERM_DEV_PLUGIN=plugins/native-batch-connections tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "pnpm assets:generate && pnpm stage:plugins && tauri build",
    "build:tauri:nsis": "pnpm assets:generate && pnpm stage:plugins && tauri build --bundles nsis",
    "stage:plugins": "node scripts/stage-builtin-plugins.mjs",
    "lint": "pnpm assets:generate && pnpm lint:eslint && pnpm lint:loc && pnpm lint:dead-code",
    "lint:tauri": "pnpm assets:generate && cargo clippy --workspace --all-targets -- -D warnings",
    "test": "pnpm assets:generate && node scripts/check-no-password-persistence.mjs && pnpm test:quality && vitest run",
    "test:tauri": "pnpm assets:generate && cargo test --workspace",
    "preview": "vite preview",
    "create:app": "powershell -ExecutionPolicy Bypass -File scripts/Build-OmniTerm.ps1",
    "create:plugin": "node scripts/create-plugin.mjs",
    "build:plugin": "node scripts/build-plugin.mjs",
    "run:plugin": "node scripts/run-plugin.mjs",
    "install:plugin": "node scripts/install-plugin.mjs",
    "test:security": "node scripts/check-no-password-persistence.mjs",
    "lint:eslint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:loc": "node scripts/check-loc.mjs",
    "test:quality": "node --test \"scripts/__tests__/*.test.mjs\"",
    "coverage:js": "pnpm assets:generate && vitest run --coverage",
    "lint:dead-code": "node scripts/check-dead-code.mjs",
    "assets:generate": "node scripts/generate-app-assets.mjs",
    "typecheck": "pnpm assets:generate && tsc -b && tsc -p ui/ide --noEmit",
    "gen:bindings": "cargo test -j 4 -p omniterm --lib idea_host::bindings::gen_bindings -- --ignored --exact",
    "prepare": "husky || true",
    "check:push": "node scripts/pre-push-check.mjs",
    "identity:setup": "node scripts/identity-setup.mjs",
    "github": "node scripts/github.mjs",
    "bump:version": "node scripts/bump-version.mjs",
    "version:sync": "node scripts/sync-tauri-version.mjs write",
    "version:validate": "node scripts/sync-tauri-version.mjs validate"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sass": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@floating-ui/react-dom": "^2.1.9",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/lr": "^1.4.12",
    "@omniterm/contract": "workspace:*",
    "@replit/codemirror-vim": "6.4.0",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "anser": "^2.3.5",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "emmet": "2.4.11",
    "immer": "^11.2.9",
    "lucide-react": "^1.17.0",
    "marked": "^18.1.3",
    "mermaid": "^11.16.0",
    "react": "^19.3.1",
    "react-colorful": "5.6.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.20.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.10.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.15",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  }
}
