{
  "name": "omniterm",
  "description": "OmniTerm: an offline multi-window SSH/RDP/local terminal and connection manager for Windows and macOS.",
  "author": "OmniTerm Contributors",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:frontend": "vite",
    "build:frontend": "tsc && vite build",
    "tauri:dev": "pnpm tauri:dev:basic",
    "tauri:dev:basic": "tauri dev",
    "tauri:dev:full": "cross-env OMNITERM_DEV_PLUGIN=plugins/full-connection-manager tauri dev",
    "tauri:dev:limited": "cross-env OMNITERM_DEV_PLUGIN=plugins/native-batch-connections tauri dev",
    "tauri:build": "tauri build",
    "build:tauri:nsis": "tauri build --bundles nsis",
    "lint": "pnpm lint:eslint && pnpm lint:loc",
    "lint:tauri": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test": "node scripts/check-no-password-persistence.mjs && pnpm test:quality && vitest run",
    "test:tauri": "cargo test --manifest-path src-tauri/Cargo.toml",
    "preview": "vite preview",
    "create:app": "powershell -ExecutionPolicy Bypass -File scripts/Build-OmniTerm.ps1",
    "create:plugin": "node scripts/create-plugin.mjs",
    "build:plugin": "node scripts/build-plugin.mjs",
    "run:plugin": "node scripts/run-plugin.mjs",
    "install:plugin": "node scripts/install-plugin.mjs",
    "test:security": "node scripts/check-no-password-persistence.mjs",
    "lint:eslint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:loc": "node scripts/check-loc.mjs",
    "test:quality": "node --test scripts/__tests__/check-loc.test.mjs scripts/__tests__/check-coverage.test.mjs",
    "coverage:js": "vitest run --coverage"
  },
  "dependencies": {
    "@omniterm/contract": "workspace:*",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-os": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "mermaid": "^11.16.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "potrace": "^2.1.8",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.2.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  }
}
