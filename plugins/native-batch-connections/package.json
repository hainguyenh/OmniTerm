{
  "name": "@omniterm/native-batch-connections",
  "version": "0.1.1",
  "private": true,
  "description": "Limited, password-free OmniTerm provider backed only by OS-native launch scripts.",
  "type": "commonjs",
  "main": "dist/index.js",
  "omnitermPlugin": {
    "apiVersion": 2,
    "hostVersion": ">=0.1.0 <1.0.0",
    "displayName": "Limited Connections",
    "permissions": ["connections", "workspace", "openExternal"]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.2.2"
  }
}
