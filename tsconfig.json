{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* The IDE modules under ui/ide import each other through "@/" */
    "paths": { "@/*": ["./ui/ide/*"] },
    /* TypeScript 6 no longer loads every @types package; tests and the plugin probes use Node globals. */
    "types": ["node", "vite/client"]
  },
  "include": ["ui", "plugins/always-awake/app", "plugins/agent-quota/app"],
  /* Ambient module declarations of the IDE modules, which `exclude` would otherwise drop. */
  "files": ["ui/ide/emmet.d.ts"],
  "exclude": ["ui/ide"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
